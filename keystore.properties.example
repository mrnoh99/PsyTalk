# Play Store 릴리스 서명 — 이 파일을 keystore.properties 로 복사한 뒤 값을 채우세요.
# keystore.properties 는 Git에 올리지 마세요 (.gitignore 등록됨).
#
# 키스토어 생성 예:
#   keytool -genkey -v -keystore release.keystore -alias psytalk -keyalg RSA -keysize 2048 -validity 10000
#
storeFile=release.keystore
storePassword=YOUR_STORE_PASSWORD
keyAlias=psytalk
keyPassword=YOUR_KEY_PASSWORD
